<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Desktop host for Windows and Linux: local Blazor Server app on 127.0.0.1, shown in a browser app window. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>BlueTube</AssemblyName>
    <RootNamespace>BlueTube.Desktop</RootNamespace>
    <!-- Windows: GUI app, no console window. The server runs hidden and stops 30 s after the last window closes.
         Linux: no effect (same as Exe). -->
    <OutputType>WinExe</OutputType>
    <!-- Windows: icon of BlueTube.exe (Explorer, taskbar, shortcuts). 16-256 px. -->
    <ApplicationIcon>bluetube.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Linux: icon for a .desktop launcher. Copied next to the executable. -->
    <None Update="bluetube.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BlueTube.Core\BlueTube.Core.csproj" />
    <ProjectReference Include="..\BlueTube.UI\BlueTube.UI.csproj" />
  </ItemGroup>

</Project>
