<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Desktop host for Windows and Linux: local Blazor Server app on 127.0.0.1, shown in a browser app window. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>BlueTube</AssemblyName>
    <RootNamespace>BlueTube.Desktop</RootNamespace>
    <!-- Windows: no console window. The server runs hidden and stops 30 s after the last window closes.
         Do NOT use OutputType=WinExe: the SDK then drops _framework/blazor.web.js (pages stop working).
         Instead keep Exe and ask the SDK for a GUI (subsystem 2) apphost. Internal SDK property, checked in
         SDK 10.0.401 (Microsoft.NET.Sdk.targets). The desktop CI workflow checks both effects. -->
    <OutputType>Exe</OutputType>
    <_UseWindowsGraphicalUserInterface Condition="$(RuntimeIdentifier.StartsWith('win'))">true</_UseWindowsGraphicalUserInterface>
    <!-- Windows: icon of BlueTube.exe (Explorer, taskbar, shortcuts). 16-256 px. -->
    <ApplicationIcon>bluetube.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Linux: icon for a .desktop launcher. Copied next to the executable. -->
    <None Update="bluetube.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BlueTube.Core\BlueTube.Core.csproj" />
    <ProjectReference Include="..\BlueTube.UI\BlueTube.UI.csproj" />
  </ItemGroup>

</Project>
