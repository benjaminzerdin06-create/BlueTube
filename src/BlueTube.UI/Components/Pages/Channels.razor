@page "/channels"
@inject FeedService Feed
@inject IVideoRepository Repo
@inject IJSRuntime JS

<header class="page-header"><h1>Channels</h1></header>

<div class="page-body">
    <form class="add" @onsubmit="AddAsync">
        <input placeholder="@@handle, UC... ID or channel URL" @bind="_input" @bind:event="oninput" disabled="@_busy" />
        <input placeholder="Tags, comma-separated (optional)" @bind="_tags" disabled="@_busy" />
        <button class="primary" type="submit" disabled="@(_busy || string.IsNullOrWhiteSpace(_input))">
            @(_busy ? "Adding…" : "Add channel")
        </button>
    </form>

    @if (_message is not null)
    {
        <p class="message @(_messageIsError ? "error" : "")">@_message</p>
    }

    @* Curated channel list (Core/LearningLibrary.cs). One tap adds all. *@
    <details class="library">
        <summary>Learning library · @LearningLibrary.Channels.Count channels</summary>
        <p class="hint">Hand-picked channels for your goals. A channel is added only if YouTube confirms its name.</p>
        @foreach (var topic in LearningLibrary.Topics)
        {
            <h4>@topic</h4>
            <ul class="lib-list">
                @foreach (var e in LearningLibrary.Channels.Where(c => c.Topic == topic))
                {
                    <li><b>@e.Name</b> <span class="why">@e.Why</span></li>
                }
            </ul>
        }
        <button class="primary" @onclick="AddLibraryAsync" disabled="@_busy">
            @(_busy ? "Adding library…" : "Add library")
        </button>
        @if (_libraryReport is not null)
        {
            <p class="report">@_libraryReport</p>
        }
    </details>

    @if (_channels is null)
    {
        <div class="state"><div class="spinner"></div></div>
    }
    else if (_channels.Count == 0)
    {
        <div class="state">No channels. Add one above.</div>
    }
    else
    {
        <ul class="list">
            @foreach (var c in _channels)
            {
                <li @key="c.Id">
                    @if (c.ThumbnailUrl.Length > 0)
                    {
                        <img src="@c.ThumbnailUrl" alt="" loading="lazy" />
                    }
                    else
                    {
                        <span class="avatar">@(c.Title.Length > 0 ? c.Title[..1] : "?")</span>
                    }
                    <div class="main">
                        <div class="name">@c.Title</div>
                        @if (_editingId == c.Id)
                        {
                            <form class="edit" @onsubmit="() => SaveTagsAsync(c)">
                                <input @bind="_editTags" placeholder="unity, csharp" />
                                <button type="submit">Save</button>
                            </form>
                        }
                        else
                        {
                            <div class="tags" @onclick="() => StartEdit(c)">
                                @if (c.TagList.Count == 0)
                                {
                                    <span class="hint">+ tags</span>
                                }
                                @foreach (var t in c.TagList)
                                {
                                    <TagChip Tag="@t" />
                                }
                            </div>
                        }
                    </div>
                    @if (_confirmDeleteId == c.Id)
                    {
                        <button class="danger" @onclick="() => DeleteAsync(c)">Remove?</button>
                    }
                    else
                    {
                        <button class="remove" @onclick="() => _confirmDeleteId = c.Id" aria-label="Remove">✕</button>
                    }
                </li>
            }
        </ul>
    }

    @* Copy the channel list between phone and PC. Text only: works the same in WebView and browser. *@
    <details class="transfer">
        <summary>Export / import channels</summary>
        <p class="hint">Export: copy this text to the other device. Import: paste text from the other device, then tap Import. Import uses no YouTube quota.</p>
        <textarea rows="6" @bind="_transferText" @bind:event="oninput" spellcheck="false"></textarea>
        <div class="row">
            <button @onclick="CopyExportAsync">Copy</button>
            <button class="primary" @onclick="ImportAsync" disabled="@string.IsNullOrWhiteSpace(_transferText)">Import</button>
        </div>
    </details>
</div>

@code {
    private string _transferText = "";
    private string? _libraryReport;

    private async Task AddLibraryAsync()
    {
        _busy = true;
        _libraryReport = null;
        try
        {
            var r = await Feed.AddLibraryAsync(LearningLibrary.Channels);
            var lines = new List<string> { $"Added {r.Added.Count}. Already there: {r.AlreadyThere.Count}." };
            if (r.NotFound.Count > 0) lines.Add("Not found: " + string.Join(", ", r.NotFound));
            if (r.Mismatch.Count > 0) lines.Add("Refused (name mismatch): " + string.Join("; ", r.Mismatch));
            lines.Add("Refresh the feed to get videos.");
            _libraryReport = string.Join("\n", lines);
            await LoadAsync();
        }
        catch (Exception e)
        {
            _libraryReport = ErrorText.For(e);
        }
        finally
        {
            _busy = false;
        }
    }
    private IReadOnlyList<Channel>? _channels;
    private string _input = "";
    private string _tags = "";
    private bool _busy;
    private string? _message;
    private bool _messageIsError;
    private string? _editingId;
    private string _editTags = "";
    private string? _confirmDeleteId;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _channels = await Repo.GetChannelsAsync();
        // The transfer box always shows the current list, ready to copy.
        _transferText = ChannelTransfer.Export(_channels);
    }

    private async Task AddAsync()
    {
        if (string.IsNullOrWhiteSpace(_input)) return;
        _busy = true;
        _message = null;
        try
        {
            var channel = await Feed.AddChannelAsync(_input, TagHelper.Parse(_tags));
            if (channel is null)
            {
                Show("Channel not found.", error: true);
            }
            else
            {
                Show($"Added {channel.Title}. Refresh the feed to get videos.", error: false);
                _input = "";
                _tags = "";
                await LoadAsync();
            }
        }
        catch (Exception e)
        {
            Show(ErrorText.For(e), error: true);
        }
        finally
        {
            _busy = false;
        }
    }

    private void StartEdit(Channel c)
    {
        _editingId = c.Id;
        _editTags = c.Tags.Replace(",", ", ");
    }

    private async Task SaveTagsAsync(Channel c)
    {
        c.TagList = TagHelper.Parse(_editTags);
        await Repo.UpsertChannelAsync(c);
        _editingId = null;
    }

    private async Task DeleteAsync(Channel c)
    {
        await Repo.DeleteChannelAsync(c.Id);
        _confirmDeleteId = null;
        await LoadAsync();
    }


    private async Task CopyExportAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", _transferText);
            Show("Copied.", error: false);
        }
        catch (JSException)
        {
            Show("Cannot copy here. Select the text and copy it.", error: true);
        }
    }

    private async Task ImportAsync()
    {
        try
        {
            var added = await Feed.ImportChannelsAsync(_transferText);
            Show($"Imported {added} new channels. Refresh the feed to get videos.", error: false);
            await LoadAsync();
        }
        catch (FormatException e)
        {
            Show(e.Message, error: true);
        }
    }

    private void Show(string text, bool error)
    {
        _message = text;
        _messageIsError = error;
    }
}
