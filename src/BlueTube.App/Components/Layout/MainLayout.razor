@inherits LayoutComponentBase
@inject IVideoRepository Repo

<div class="layout">
    <main class="content">
        @if (_error is not null)
        {
            <div class="state error">Cannot open the database. @_error</div>
        }
        else if (!_ready)
        {
            <div class="state"><div class="spinner"></div></div>
        }
        else
        {
            @Body
        }
    </main>

    <nav class="tabs">
        <NavLink href="" Match="NavLinkMatch.All">
            <svg viewBox="0 0 24 24"><path d="M3 10.5 12 3l9 7.5V21h-6v-6H9v6H3z" /></svg>
            <span>Feed</span>
        </NavLink>
        <NavLink href="shorts">
            <svg viewBox="0 0 24 24"><path d="M7 2h10a2 2 0 0 1 2 2v16a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2zm3 6v8l6-4z" /></svg>
            <span>Shorts</span>
        </NavLink>
        <NavLink href="channels">
            <svg viewBox="0 0 24 24"><path d="M4 6h16v2H4zm0 5h16v2H4zm0 5h10v2H4z" /></svg>
            <span>Channels</span>
        </NavLink>
        <NavLink href="settings">
            <svg viewBox="0 0 24 24"><path d="M19.4 13a7.6 7.6 0 0 0 0-2l2.1-1.6-2-3.5-2.5 1a7.7 7.7 0 0 0-1.7-1L15 3h-4l-.4 2.7a7.7 7.7 0 0 0-1.7 1l-2.5-1-2 3.5L6.6 11a7.6 7.6 0 0 0 0 2l-2.1 1.6 2 3.5 2.5-1c.5.4 1.1.7 1.7 1L11 21h4l.4-2.7c.6-.3 1.2-.6 1.7-1l2.5 1 2-3.5zM13 15.5a3.5 3.5 0 1 1 0-7 3.5 3.5 0 0 1 0 7z" /></svg>
            <span>Settings</span>
        </NavLink>
    </nav>
</div>

@code {
    private bool _ready;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await Repo.InitAsync();
            _ready = true;
        }
        catch (Exception e)
        {
            _error = e.Message;
        }
    }
}
