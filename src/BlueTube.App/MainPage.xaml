<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:BlueTube.App"
             xmlns:ui="clr-namespace:BlueTube.UI.Components;assembly=BlueTube.UI"
             x:Class="BlueTube.App.MainPage"
             BackgroundColor="#0b0f17"
             SafeAreaEdges="All">
    <!-- SafeAreaEdges: keep the WebView out of the status bar and navigation bar. -->

    <BlazorWebView x:Name="blazorWebView" HostPage="wwwroot/index.html">
        <BlazorWebView.RootComponents>
            <RootComponent Selector="#app" ComponentType="{x:Type ui:Routes}" />
        </BlazorWebView.RootComponents>
    </BlazorWebView>

</ContentPage>
