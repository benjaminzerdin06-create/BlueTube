<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <TargetFrameworks>net10.0-android</TargetFrameworks>
        <OutputType>Exe</OutputType>
        <RootNamespace>BlueTube.App</RootNamespace>
        <UseMaui>true</UseMaui>
        <SingleProject>true</SingleProject>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <!-- Blazor handles CSS, not MAUI. -->
        <EnableDefaultCssItems>false</EnableDefaultCssItems>
        <MauiXamlInflator>SourceGen</MauiXamlInflator>

        <ApplicationTitle>BlueTube</ApplicationTitle>
        <ApplicationId>com.bluetube.app</ApplicationId>
        <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
        <ApplicationVersion>1</ApplicationVersion>

        <SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>

        <!-- Sideloaded app: build an .apk, not a Play Store .aab. -->
        <AndroidPackageFormat>apk</AndroidPackageFormat>
    </PropertyGroup>

    <ItemGroup>
        <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" />
        <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#0b0f17" BaseSize="128,128" />
        <MauiFont Include="Resources\Fonts\*" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
        <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="$(MauiVersion)" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\BlueTube.Core\BlueTube.Core.csproj" />
    </ItemGroup>

</Project>
